  "adjRecovery": "Water correction",
  "adjRecoveryHelp": "Controls the underwater cast-recovery stage only. It strengthens color recovery and local neutralization, but does not scale exposure, contrast, saturation, or sharpening.",
  "adjContrastStretch": "Contrast stretch",
  "adjContrastStretchHelp": "Expands the measured dark-to-bright range. High values can make murky scenes punchier but may clip detail.",
  "adjContrast": "Contrast",
  "adjContrastHelp": "Changes separation around the midtones without re-running the underwater color recovery.",
  "adjGamma": "Gamma",
  "adjGammaHelp": "Moves midtone brightness while keeping the black and white endpoints mostly fixed.",
  "adjBrightness": "Brightness",
  "adjBrightnessHelp": "Adds or removes a uniform amount of light after the main correction.",
  "adjExposure": "Exposure",
  "adjExposureHelp": "Multiplies scene brightness like a small exposure adjustment. It affects shadows and highlights together.",
  "adjHighlights": "Highlights",
  "adjHighlightsHelp": "Brightens or darkens the lightest parts while protecting the rest of the tonal range.",
  "adjShadows": "Shadows",
  "adjShadowsHelp": "Opens or deepens darker areas without applying a full-image brightness change.",
  "adjBlackPoint": "Black point",
  "adjBlackPointHelp": "Deepens the darkest tones. Increase carefully to avoid losing shadow detail.",
  "adjTemperature": "Temperature",
  "adjTemperatureHelp": "Final warm-cool trim after the water correction. The white balance picker sets it from a tap.",
  "adjTint": "Tint",
  "adjTintHelp": "Final green-magenta trim. Positive values remove a leftover green cast.",
  "adjRedRecovery": "Red recovery",
  "adjRedRecoveryHelp": "Targets warm colors absorbed by water. Its result is multiplied by Water correction, so both controls work together.",
  "adjAutoWhiteBalance": "Auto white balance",
  "adjAutoWhiteBalanceHelp": "Balances the average red, green, and blue levels within safe bounds. Lower it when intentional lighting should stay warm or cool.",
  "adjSaturation": "Saturation",
  "adjSaturationHelp": "Changes the intensity of all colors equally. High values can exaggerate color noise and water tint.",
  "adjVibrance": "Vibrance",
  "adjVibranceHelp": "Boosts muted colors more than colors that are already strong.",
  "adjHue": "Hue",
  "adjHueHelp": "Small hue rotations help match strobes, filters, and water type.",
  "adjHighlightProtection": "Highlight protection",
  "adjHighlightProtectionHelp": "Reduces correction in the brightest areas to preserve strobes, the sun, and reflective equipment.",
  "adjHazeReduction": "Haze reduction",
  "adjHazeReductionHelp": "Reduces blue-green veil and increases separation in low-contrast water.",
  "adjClarity": "Clarity",
  "adjClarityHelp": "Adds local midtone contrast to reveal texture. It is gentler than sharpening edges directly.",
  "adjSharpness": "Sharpness",
  "adjSharpnessHelp": "Strengthens fine edges during export. Too much can emphasize noise or compression artifacts.",
  "adjVignette": "Vignette",
  "adjVignetteHelp": "Darkens the image edges to guide attention toward the center.",
